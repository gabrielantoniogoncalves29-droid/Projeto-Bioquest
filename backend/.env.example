PORT=3000
NODE_ENV=development

# Caminho do banco SQLite. 
DB_PATH=data/bioquest.db
UPLOADS_DIR=uploads

# Endereços do front-end liberados no CORS 
FRONTEND_URL=http://localhost:5173,https://SEU-USUARIO.github.io

# Painel temporário de cadastro de questões (/admin).
# Em desenvolvimento fica ligado. Em produção só liga com ADMIN_ATIVO=true.
ADMIN_ATIVO=true
ADMIN_SENHA=troque-esta-senha

JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Fórum: comentar exige login (ainda não existe). Deixe false até o login ser feito.
FORUM_ABERTO=false
EXPORTAR_QUESTOES=true
